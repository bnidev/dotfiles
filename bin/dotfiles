#!/bin/bash

# ----
# This script is mostly taken over from TechDufus (github.com/TechDufus) and modified to fit my needs.
# ----

source "$(dirname "$0")/../lib/colors"
source "$(dirname "$0")/../lib/utils"
source "$(dirname "$0")/../lib/os_setup"

set -e

# Check for tput (required for cursor control)
if ! command -v tput &> /dev/null; then
  echo -e "${CAT_RED}Error: 'tput' is required but not found.${NC}"
  echo -e "${CAT_SUBTEXT1}Please install ncurses (Ubuntu: apt install ncurses-bin, Arch: pacman -S ncurses)${NC}"
  exit 1
fi

# Early check for help/version flags (before setup)
for arg in "$@"; do
  case $arg in
    -h|--help)
      SHOW_HELP=true
      ;;
    --version)
      SHOW_VERSION=true
      ;;
  esac
done

# Paths
CONFIG_DIR="$HOME/.config/dotfiles"
DOTFILES_DIR="$HOME/.dotfiles"
DOTFILES_LOG="$HOME/.dotfiles.log"
DOTFILES_VERSION="1.0.0"
SSH_DIR="$HOME/.ssh"

trap cleanup EXIT INT TERM

# Handle early exit for help/version (before setup)
if [[ "${SHOW_HELP:-}" == "true" ]]; then
  show_help
  exit 0
fi

if [[ "${SHOW_VERSION:-}" == "true" ]]; then
  show_version
  exit 0
fi

dotfiles_os=$(detect_os)
__task "Loading Setup for detected OS: $dotfiles_os"
case $dotfiles_os in
  ubuntu)
    ubuntu_setup
    ;;
  arch)
    arch_setup
    ;;
  *)
    __task "Unsupported OS"
    _cmd "echo 'Unsupported OS'"
    ;;
esac

if ! [[ -d "$DOTFILES_DIR" ]]; then
  __task "Downloading dotfiles repository (This may take a minute)"
  _cmd "git clone --quiet https://github.com/bnidev/dotfiles.git $DOTFILES_DIR"
  _task_done
else
  __task "Updating dotfiles repository"
  _cmd "git -C $DOTFILES_DIR pull --quiet"
  _task_done
fi

pushd "$DOTFILES_DIR" 2>&1 > /dev/null

if ! [[ -f "$CONFIG_DIR/config.yml" ]]; then
  echo -e "${YELLOW} [?]  ${CAT_MAUVE}'config.yml' ${CAT_TEXT}file missing in ${CAT_MAUVE}'$CONFIG_DIR'${NC}."
  read -p "$(echo -e "${YELLOW}Do you want to copy the template? (y/N) ${NC}")" -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    if ! [[ -d "$CONFIG_DIR" ]]; then
      mkdir -p "$CONFIG_DIR"
    fi
    cp $DOTFILES_DIR/templates/config.template.yml $CONFIG_DIR/config.yml
    echo -e "${GREEN} [✓]  ${CAT_MAUVE}'config.yml' ${CAT_TEXT}template copied to ${CAT_MAUVE}'$CONFIG_DIR'${CAT_TEXT}. You can start editing the file now.${NC}"
  else
    echo -e "${YELLOW} [!]  ${CAT_TEXT}Config setup cancelled${NC}"
  fi
  popd 2>&1 > /dev/null
  exit 0
fi


if ! [[ -f "$SSH_DIR/id_rsa" ]]; then
  echo -e "${YELLOW} [?]  ${CAT_TEXT}No SSH key found in ${CAT_MAUVE}'$SSH_DIR'${CAT_TEXT}.${NC}"
  read -p "$(echo -e "${YELLOW}Do you want to generate SSH keys? (y/N) ${NC}")" -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    if ! [[ -d "$SSH_DIR" ]]; then
      mkdir -p "$SSH_DIR"
      chmod 700 "$SSH_DIR"
    fi
    ssh-keygen -b 4096 -t rsa -f "$SSH_DIR/id_rsa" -N '' -C "$USER@$HOSTNAME"
    cat "$SSH_DIR/id_rsa.pub" >> "$SSH_DIR/authorized_keys"
    echo -e "${GREEN} [✓]  ${CAT_TEXT}SSH keys generated in ${CAT_MAUVE}'$SSH_DIR'${CAT_TEXT}.${NC}"
  else
    echo -e "${YELLOW} [!]  ${CAT_TEXT}SSH key generation skipped${NC}"
  fi
fi

ansible-playbook --ask-become-pass -i "$DOTFILES_DIR/hosts" --extra-vars "@$CONFIG_DIR/config.yml" "$DOTFILES_DIR/main.yml" "$@"
